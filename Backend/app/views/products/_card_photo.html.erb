<%# locals: (product:) %>
<%# Katalog kartı yalnızca ana görseli gösterir (with_attached_main_image ile önceden yüklenir, N+1 yok).
    Galeri fotoğrafları sadece ürün sayfasında görünür; kartta fotoğraf değiştirme düğmesi ve aksiyonu yoktur. %>
<%= link_to product_path(product), data: { turbo_frame: "main" }, tabindex: -1,
      class: "block overflow-hidden rounded-[2px] bg-[var(--kraft)]" do %>
  <%= image_tag product_image_url(product), alt: product.name, loading: "lazy",
        class: "aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" %>
<% end %>
