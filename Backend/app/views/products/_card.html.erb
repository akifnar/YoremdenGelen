<%# locals: (product:) %>
<%# Turbo Stream yayınlarında da render edildiği için kullanıcıya özel veri (current_user vb.) kullanılmaz. %>
<%# Kart, sayfa kâğıdı üzerinde duran küçük bir not (.note). %>
<article id="<%= dom_id(product, :card) %>" class="note group flex min-w-0 flex-col p-3"
         data-controller="hover-metric" data-hover-metric-url-value="<%= hover_product_path(product) %>"
         data-action="mouseenter->hover-metric#start mouseleave->hover-metric#cancel">
  <div class="relative">
    <%= render "products/card_photo", product: product, photo_index: 0 %>
    <% unless product.available? %>
      <%# Mühür görünümlü etiket. %>
      <span class="pointer-events-none absolute left-3 top-3 rotate-[-6deg] rounded-[3px] border-2 border-[#a94438] bg-[var(--paper-hi)]/85 px-2 py-0.5 font-display text-xs font-extrabold uppercase tracking-wider text-[#a94438]">Tükendi</span>
    <% end %>
  </div>

  <%# İsim ve fiyat alt alta: dar kartlarda da isim sıkışmaz. %>
  <div class="mt-3 flex flex-1 flex-col gap-1">
    <h3 class="min-h-[2.5rem] min-w-0 font-sans text-sm font-medium leading-5 text-[var(--ink)]">
      <%= link_to product.name, product_path(product), data: { turbo_frame: "main" }, class: "line-clamp-2 hover:text-[var(--blue-ink)]" %>
    </h3>
    <p class="mt-auto font-display text-base font-bold tabular-nums text-[var(--ink)]"><%= format_price(product.price) %></p>
  </div>

  <%# Kart kategori frame'i içinde; form main frame'ini hedefler ki misafirin login yönlendirmesi kategori kutusunda değil sayfa içeriğinde açılsın. %>
  <%= button_to cart_items_path, params: { product_id: product.id, quantity: 1 }, form_class: "mt-3",
        form: { data: { turbo_frame: "main" } },
        disabled: !product.available?, aria: { label: "#{product.name} sepete ekle" },
        class: button_classes(variant: :secondary, size: :sm, extra: "w-full") do %>
    <%= cart_icon(css_class: "h-4 w-4 opacity-70") %>
    Sepete ekle
  <% end %>
</article>
