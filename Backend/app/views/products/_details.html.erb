<%# locals: (product:) %>
<%# Turbo Stream yayınlarında da render edildiği için kullanıcıya özel veri kullanılmaz. %>
<% photos = product_photo_urls(product) %>
<section id="<%= dom_id(product, :details) %>" data-controller="gallery"
         class="mt-6 grid overflow-hidden rounded-2xl border border-[var(--line)] bg-[var(--surface)] lg:grid-cols-[1.05fr_0.95fr]">
  <div class="border-b border-[var(--line)] bg-[var(--muted)] lg:border-b-0 lg:border-r">
    <div class="relative aspect-[4/3] overflow-hidden lg:aspect-auto lg:min-h-[34rem]">
      <%= image_tag photos.first, alt: "#{product.name} görseli", data: { gallery_target: "image" },
            class: "absolute inset-0 h-full w-full object-cover motion-safe:animate-photo-fade" %>
      <% if photos.length > 1 %>
        <button type="button" aria-label="Önceki ürün fotoğrafı" data-action="gallery#previous"
                class="<%= button_classes(variant: :quiet, size: :icon, extra: "absolute left-3 top-1/2 -translate-y-1/2 bg-[var(--paper-hi)]/90 hover:bg-[var(--paper-hi)]") %>">‹</button>
        <button type="button" aria-label="Sonraki ürün fotoğrafı" data-action="gallery#next"
                class="<%= button_classes(variant: :quiet, size: :icon, extra: "absolute right-3 top-1/2 -translate-y-1/2 bg-[var(--paper-hi)]/90 hover:bg-[var(--paper-hi)]") %>">›</button>
      <% end %>
    </div>
    <% if photos.length > 1 %>
      <div class="grid grid-cols-4 gap-2 border-t border-[var(--line)] p-2">
        <% photos.each_with_index do |photo, index| %>
          <button type="button" aria-label="<%= index + 1 %>. fotoğrafı göster" aria-pressed="<%= index.zero? %>"
                  data-gallery-target="thumb" data-action="gallery#show" data-gallery-index-param="<%= index %>" data-url="<%= photo %>"
                  class="aspect-square w-full overflow-hidden border aria-pressed:border-[var(--ink)] border-[var(--line)]">
            <%= image_tag photo, alt: "", loading: "lazy", class: "h-full w-full object-cover" %>
          </button>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="flex flex-col px-6 py-8 text-[var(--ink)] sm:px-10 sm:py-12 lg:px-12">
    <div class="flex items-center justify-between gap-4 border-b border-[var(--line)] pb-5">
      <p class="text-xs font-semibold uppercase tracking-widest text-[var(--subtle)]"><%= product.category.presence || "Yöresel ürün" %></p>
      <p class="text-xs text-[var(--subtle)]"><%= product.available? ? "Stokta" : "Tükendi" %></p>
    </div>
    <h1 class="mt-7 font-display text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl"><%= product.name %></h1>
    <%= render "products/rating_summary", product: product %>
    <% if product.seller %>
      <div class="mt-4 flex items-center gap-3">
        <%= render "shared/avatar", user: product.seller, size: "h-9 w-9 text-sm" %>
        <div class="min-w-0">
          <p class="text-xs uppercase tracking-wide text-[var(--subtle)]">Satıcı</p>
          <%# Satıcının diğer ürünleri: /saticilar/:id %>
          <%= link_to product.seller.name, seller_path(product.seller), class: "text-sm font-semibold hover:text-[var(--accent-ink)] hover:underline" %>
        </div>
      </div>
    <% else %>
      <p class="mt-4 text-sm text-[var(--subtle)]">Satıcı: Yöremden Gelen</p>
    <% end %>
    <p class="mt-5 text-2xl font-medium tabular-nums"><%= format_price(product.price) %></p>

    <div class="mt-8 border-t border-[var(--line)] pt-6">
      <h2 class="text-xs font-semibold uppercase tracking-widest text-[var(--subtle)]">Ürün açıklaması</h2>
      <p class="mt-3 max-w-prose whitespace-pre-line text-[15px] leading-7 text-[var(--subtle)]"><%= product.description %></p>

      <%= form_with url: cart_items_path, class: "mt-6 flex flex-wrap items-center gap-3", data: { controller: "quantity" } do |form| %>
        <%= form.hidden_field :product_id, value: product.id %>
        <div class="inline-flex items-center border border-[var(--line)]" role="group" aria-label="Ürün adedi">
          <button type="button" aria-label="Adedi azalt" data-action="quantity#decrement" <%= "disabled" unless product.available? %>
                  class="px-3 py-2 text-lg text-stone-600 disabled:opacity-40">−</button>
          <%= form.number_field :quantity, value: 1, min: 1, max: [ product.stock, 1 ].max, disabled: !product.available?,
                aria: { label: "İstenen ürün adedi" }, data: { quantity_target: "input" },
                class: "w-14 border-0 bg-transparent px-1 py-2 text-center text-sm tabular-nums [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none" %>
          <button type="button" aria-label="Adedi artır" data-action="quantity#increment" <%= "disabled" unless product.available? %>
                  class="px-3 py-2 text-lg text-stone-600 disabled:opacity-40">+</button>
        </div>
        <%= form.button type: "submit", disabled: !product.available?, title: "Sepete ekle", aria: { label: "Sepete ekle" },
              class: "grid h-11 w-11 place-items-center border border-[var(--line)] bg-[var(--muted)] text-[var(--ink)] opacity-75 transition-opacity hover:opacity-100 disabled:cursor-not-allowed disabled:opacity-40" do %>
          <%= cart_icon %>
        <% end %>
      <% end %>
    </div>

    <dl class="mt-auto grid grid-cols-2 gap-4 border-t border-[var(--line)] pt-6">
      <div>
        <dt class="text-xs uppercase tracking-wide text-[var(--subtle)]">Stok adedi</dt>
        <dd class="mt-1 text-sm font-medium"><%= product.stock.positive? ? "#{product.stock} adet" : "Tükendi" %></dd>
      </div>
    </dl>
  </div>
</section>
