<%# Product#broadcast_catalog_changes ürün güncellenince kartı bu kanal üzerinden değiştirir. %>
<%= turbo_stream_from :products %>

<main class="mx-auto w-full max-w-6xl px-8 py-10">
  <header class="max-w-2xl">
    <h1 class="font-display text-4xl font-extrabold tracking-tight text-[var(--ink)]">Yöresel ürünler</h1>
    <p class="mt-2 font-hand text-2xl text-[var(--ink-2)]">Üreticilerden doğrudan; her kategoride en çok ilgi görenler önce.</p>
  </header>

  <% if @category_pages.empty? %>
    <p class="mt-10 rounded-[3px] border border-dashed border-[rgba(34,30,23,0.32)] p-6 text-sm text-[var(--ink-2)]">Şu anda satışta ürün bulunmuyor.</p>
  <% else %>
    <div class="mt-10 space-y-16">
      <% @category_pages.each do |category, pagy, products| %>
        <%= render "categories/section", category: category, pagy: pagy, products: products %>
      <% end %>
    </div>
  <% end %>
</main>
