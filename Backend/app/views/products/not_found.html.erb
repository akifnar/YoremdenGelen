<% content_for :title, "Ürün bulunamadı · Yöremden Gelen" %>
<main class="mx-auto grid min-h-[55vh] w-full max-w-4xl place-items-center px-5 py-16 text-center sm:px-8">
  <section>
    <p class="text-xs font-semibold uppercase tracking-widest text-[var(--subtle)]">Ürün bulunamadı</p>
    <h1 class="mt-4 text-3xl font-extrabold text-[var(--ink)] tracking-tight">Bu ürün artık mevcut değil.</h1>
    <%= link_to root_path, class: button_classes(variant: :secondary, size: :md, extra: "mt-7 border-[var(--line)] text-[var(--ink)] hover:border-[var(--ink)] hover:bg-[var(--muted)]") do %>
      <span aria-hidden="true">←</span> Ürünlere dön
    <% end %>
  </section>
</main>
