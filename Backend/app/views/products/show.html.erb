<% content_for :title, "#{@product.name} · Yöremden Gelen" %>
<%# Satıcı ürünü güncellediğinde Product#broadcast_catalog_changes detay bölümünü bu kanaldan değiştirir. %>
<%= turbo_stream_from @product %>

<main class="mx-auto w-full max-w-6xl px-5 py-8 sm:px-8 sm:py-12">
  <%= link_to "← Tüm ürünler", root_path, class: "inline-flex border-b border-[var(--line)] pb-1 text-sm text-[var(--subtle)]" %>
  <%= render "products/details", product: @product %>
  <%= render "comments/section", product: @product, comments: @comments, pagy: @comments_pagy,
             purchase: @purchase, my_reactions: @my_reactions %>
</main>
