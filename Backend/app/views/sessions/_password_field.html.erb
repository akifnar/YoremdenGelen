<%# locals: (form:, autocomplete:) %>
<div class="block text-sm" data-controller="password-visibility">
  <%= form.label :password, "Şifre" %>
  <div class="mt-1 flex border border-stone-300">
    <%= form.password_field :password, required: true, minlength: 8, autocomplete: autocomplete,
          data: { password_visibility_target: "input" }, class: "min-w-0 flex-1 px-3 py-3 outline-none" %>
    <button type="button" aria-label="Şifreyi göster" aria-pressed="false" data-password-visibility-target="toggle"
            data-action="pointerdown->password-visibility#show pointerup->password-visibility#hide pointerleave->password-visibility#hide pointercancel->password-visibility#hide blur->password-visibility#hide keydown.space->password-visibility#show keyup->password-visibility#hide"
            class="px-3 text-lg text-stone-500 hover:bg-stone-100">
      <span aria-hidden="true">◉</span>
    </button>
  </div>
</div>
