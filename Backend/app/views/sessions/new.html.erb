<% content_for :title, "Giriş yap · Yöremden Gelen" %>
<main class="mx-auto w-full max-w-md px-5 py-12">
  <h1 class="text-2xl font-semibold">Giriş yap</h1>

  <%# Giriş header'ı (menü, sepet rozeti) değiştirdiği için form tam sayfa (_top) gönderilir. %>
  <%= form_with scope: :user, url: login_path(returnTo: @return_to), class: "mt-6 space-y-4", data: { turbo_frame: "_top" } do |form| %>
    <%= form.label :email, class: "block text-sm" do %>
      E-posta
      <%= form.email_field :email, value: @email, required: true, autocomplete: "email", class: "mt-1 block w-full border border-stone-300 px-3 py-3" %>
    <% end %>
    <%= render "sessions/password_field", form: form, autocomplete: "current-password" %>
    <%= form.label :remember_me, class: "flex items-center gap-2 text-sm text-stone-700" do %>
      <%= form.check_box :remember_me, class: "h-4 w-4 accent-stone-900" %>
      Beni hatırla
    <% end %>
    <%= form.button "Giriş yap", type: "submit", data: { turbo_submits_with: "İşleniyor…" },
          class: button_classes(variant: :primary, size: :lg, extra: "w-full") %>
  <% end %>

  <% if ENV["GOOGLE_CLIENT_ID"].present? %>
    <%# Google Identity Services "redirect" akışı: kimlik bilgisi doğrudan sessions#google'a POST edilir. %>
    <% content_for :head do %>
      <script src="https://accounts.google.com/gsi/client" async></script>
    <% end %>
    <div id="g_id_onload" data-client_id="<%= ENV["GOOGLE_CLIENT_ID"] %>" data-ux_mode="redirect"
         data-login_uri="<%= google_auth_url(returnTo: @return_to) %>" data-auto_prompt="false"></div>
    <div class="g_id_signin mt-3 flex min-h-10 justify-center" data-type="standard" data-theme="outline" data-size="large" data-width="320"></div>
  <% else %>
    <p class="mt-3 text-center text-xs text-stone-500">Google girişi için GOOGLE_CLIENT_ID ayarlanmalıdır.</p>
  <% end %>

  <p class="mt-6 text-sm text-stone-600">
    Hesabın yok mu? <%= link_to "Kayıt ol", register_path, class: "font-semibold underline" %>
  </p>
</main>
