<%# locals: (comment:, product:, my_reaction:) %>
<%# Kullanıcıya özel içerik (sil, cevap formu, tepki durumu) içerdiği için Turbo yayınlarında değil, yalnızca
    istek yanıtlarında render edilir. %>
<li id="<%= dom_id(comment) %>" class="note p-4">
  <div class="flex items-start justify-between gap-4">
    <div class="flex items-center gap-3">
      <%= render "shared/avatar", user: comment.user, size: "h-8 w-8 text-sm" %>
      <div>
        <p class="text-sm font-semibold text-[var(--ink)]"><%= comment.user.name %></p>
        <p class="text-xs text-[var(--subtle)]"><%= comment.created_at.strftime("%d.%m.%Y %H:%M") %> · Satın aldı</p>
      </div>
    </div>
    <% if current_user&.buyer? && comment.user_id == current_user.id %>
      <%= button_to "Sil", comment_path(comment), method: :delete,
            form: { data: { turbo_confirm: "Yorumun silinsin mi? Satıcının cevabı da silinir." } },
            class: "text-xs font-medium text-[var(--subtle)] underline underline-offset-2 hover:text-[#a94438]" %>
    <% end %>
  </div>

  <p class="mt-3 whitespace-pre-line text-[15px] leading-7 text-[var(--ink-2)]"><%= comment.body %></p>
  <%= render "comments/reactions", comment: comment, my_reaction: my_reaction %>

  <% if comment.reply %>
    <div class="mt-4 border-l-2 border-dashed border-[rgba(34,30,23,0.32)] pl-4">
      <p class="text-xs font-semibold text-[var(--blue-ink)]">Satıcının cevabı · <%= comment.reply.user.name %></p>
      <p class="mt-1 whitespace-pre-line text-sm leading-6 text-[var(--ink-2)]"><%= comment.reply.body %></p>
    </div>
  <% elsif current_user&.seller? && product.seller_id == current_user.id %>
    <%= form_with url: comment_reply_path(comment), scope: :reply, class: "mt-4 flex items-start gap-2" do |form| %>
      <%= form.label :body, "Cevabın", class: "sr-only", for: "reply_body_#{comment.id}" %>
      <%= form.text_area :body, required: true, rows: 2, maxlength: Comment::BODY_MAX_LENGTH, id: "reply_body_#{comment.id}",
            placeholder: "Alıcıya cevap yaz (yorum başına bir cevap)",
            class: "block w-full resize-y rounded-[3px] border border-[rgba(34,30,23,0.32)] bg-[var(--paper)] px-3 py-2 text-sm" %>
      <%= form.button "Cevapla", type: "submit", class: button_classes(variant: :secondary, size: :sm) %>
    <% end %>
  <% end %>
</li>
