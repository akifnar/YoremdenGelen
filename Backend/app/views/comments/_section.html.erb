<%# locals: (product:, comments:, pagy:, purchase:, my_reactions:) %>
<section aria-labelledby="comments_count" class="mt-12 border-t border-dashed border-[rgba(34,30,23,0.32)] pt-8">
  <%= render "comments/count", product: product %>

  <%# Yetkisi olmayana form hiç gösterilmez (purchase: User#purchase_of, tek index sorgusu). Puan formu yalnızca
      henüz puan vermemiş alıcıya, yorumdan bağımsız gösterilir. %>
  <% if purchase %>
    <%= render "product_ratings/form", product: product unless purchase.rated? %>
    <%= render "comments/form", product: product %>
  <% end %>

  <%= render "comments/list", product: product, comments: comments, pagy: pagy, my_reactions: my_reactions, can_react: purchase.present? %>
</section>
