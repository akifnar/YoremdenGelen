<%# locals: (product:, comments:, pagy:, my_reactions:) %>
<%# Sayfa bağlantıları bu frame'i hedefler: CommentsController#index yalnızca listeyi döndürür, ürün sayfası
    (ve tıklanma sayacı) yeniden çalışmaz. %>
<%= turbo_frame_tag "product_comments", class: "block" do %>
  <% if comments.empty? && pagy.page == 1 %>
    <p id="comments_empty" class="mt-6 text-sm text-[var(--subtle)]">Henüz yorum yok.</p>
  <% end %>
  <ul id="comments" class="mt-6 space-y-5">
    <% comments.each do |comment| %>
      <%= render "comments/comment", comment: comment, product: product, my_reaction: my_reactions[comment.id] %>
    <% end %>
  </ul>
  <%= render "shared/pagination", pagy: pagy %>
<% end %>
