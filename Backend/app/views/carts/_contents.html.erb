<%# locals: (cart:, items:) %>
<div id="cart_contents">
  <% if items.empty? %>
    <div class="py-16 text-center">
      <p class="text-stone-600">Sepetiniz henüz boş.</p>
      <%= link_to "Ürünleri incele", root_path, class: "mt-5 inline-flex border border-stone-800 px-5 py-3 text-sm font-semibold text-stone-900" %>
    </div>
  <% else %>
    <div class="grid gap-8 py-6 lg:grid-cols-[1fr_18rem]">
      <div class="divide-y divide-stone-200 border-y border-stone-200">
        <% cart.grouped_items(items).each do |lines| %>
          <% item = lines.first %>
          <% product = item.product %>
          <% quantity = lines.sum(&:quantity) %>
          <article class="grid grid-cols-[5rem_1fr_auto] items-center gap-4 py-4 sm:grid-cols-[6rem_1fr_auto]">
            <%= image_tag product_image_url(product), alt: product.name, class: "aspect-square w-20 object-cover sm:w-24" %>
            <div class="min-w-0">
              <%= link_to product.name, product_path(product), class: "line-clamp-2 font-medium text-stone-900" %>
              <% if lines.length > 1 %>
                <span class="mt-1 inline-flex rounded-full bg-[var(--kraft)] px-2.5 py-1 text-xs font-semibold text-[var(--blue-ink)]">Sepette <%= quantity %> adet</span>
              <% end %>
              <p class="mt-1 text-sm tabular-nums text-stone-600"><%= format_price(product.price) %></p>
              <p class="mt-1 text-xs text-stone-500">Güncel stok: <%= product.stock %></p>
              <% if quantity > product.stock %>
                <p class="mt-1 text-xs font-medium text-red-700">Stok değişti; adedi güncelleyin.</p>
              <% end %>
            </div>
            <div class="flex flex-col items-end gap-2">
              <%= form_with url: cart_item_path(item), method: :patch, data: { controller: "auto-submit" } do |form| %>
                <%= form.label :quantity, "Adet", for: "quantity-#{item.id}", class: "sr-only" %>
                <%= form.number_field :quantity, value: quantity, min: 1, max: [ product.stock, 1 ].max, id: "quantity-#{item.id}",
                      data: { action: "change->auto-submit#submit" },
                      class: "w-16 border border-stone-300 p-2 text-center text-sm tabular-nums" %>
              <% end %>
              <%= button_to "Kaldır", cart_item_path(item), method: :delete,
                    class: "h-auto px-1 py-0 text-xs text-stone-600 underline underline-offset-2 hover:text-stone-950" %>
              <p class="text-sm font-semibold tabular-nums text-stone-900"><%= format_price(quantity * product.price) %></p>
            </div>
          </article>
        <% end %>
      </div>
      <aside class="h-fit border border-stone-200 bg-[var(--paper-hi)] p-5">
        <h2 class="font-semibold text-stone-900">Sipariş özeti</h2>
        <div class="mt-5 flex justify-between border-t border-stone-200 pt-4 text-sm">
          <span>Ara toplam</span>
          <strong class="tabular-nums"><%= format_price(cart.subtotal(items)) %></strong>
        </div>
        <p class="mt-3 text-xs leading-5 text-stone-500">Fiyat ve stok bilgileri her sepet isteğinde ürün kataloğundan güncellenir.</p>
        <%# Gerçek ödeme yok: sipariş stoktan düşer ve alınan ürünlere yorum yetkisi verir. %>
        <%= button_to "Siparişi tamamla", cart_checkout_path, form_class: "mt-4",
              form: { data: { turbo_confirm: "Siparişi tamamlamak istiyor musun?" } },
              class: button_classes(variant: :primary, size: :md, extra: "w-full") %>
      </aside>
    </div>
  <% end %>
</div>
