<%# locals: (eyebrow:, title:, lead:, extra_class: nil) %>
<%# Bilgi sayfalarının (gizlilik, koşullar, teslimat-iade) başlık bloğu. %>
<header class="<%= extra_class %>">
  <p class="font-semibold text-[var(--blue-ink)]"><%= eyebrow %></p>
  <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-[var(--ink)] sm:text-5xl"><%= title %></h1>
  <p class="mt-4 max-w-2xl text-lg leading-8 text-stone-600"><%= lead %></p>
</header>
