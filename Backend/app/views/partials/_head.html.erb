<%# Tam sayfa (application) ve ana içerik frame'i (main_frame) layout'larının ortak <head> içeriği.
    Turbo, frame yanıtındaki <head>'i sayfaya birleştirir: <title> güncellenir, data-turbo-track'li
    dosyalar aynı kaldığı için yeniden yüklenmez. %>
<title><%= content_for(:title).presence || "Yöremden Gelen" %></title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="application-name" content="Yöremden Gelen">
<%# Link tıklamalarında önbellekteki eski sayfa önizleme olarak gösterilmez; sayfa bir kez, güncel haliyle çizilir.
    Geri/ileri düğmeleri önbelleği kullanmaya devam eder. %>
<meta name="turbo-cache-control" content="no-preview">
<%= csrf_meta_tags %>
<%= csp_meta_tag %>
<%= yield :head %>
<%# Tema yazı tipleri: başlıklar Bricolage Grotesque, metin Instrument Sans, el yazısı notlar Caveat. %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Caveat:wght@500;700&family=Instrument+Sans:wght@400..700&display=swap">
<%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
<%= javascript_importmap_tags %>
