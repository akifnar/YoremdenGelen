  <section>
    <p class="text-sm font-bold uppercase tracking-[0.2em] text-[var(--accent-ink)]">404 · Sayfa bulunamadı</p>
    <h1 class="mt-4 text-4xl font-bold text-[var(--ink)]">Aradığın sayfa burada yok.</h1>
