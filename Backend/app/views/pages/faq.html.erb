<% content_for :title, "Sıkça sorulan sorular · Yöremden Gelen" %>
<% questions = [
     [ "Yöremden Gelen nedir?",
       "Yöremden Gelen, yerel üreticilerin özenle hazırladığı ürünleri bir araya getirmeyi amaçlayan bir alışveriş platformudur." ],
     [ "Ürünler hakkında nereden bilgi alabilirim?",
       "Ürünlerin açıklama ve özelliklerini ilgili ürün sayfasında bulabilirsin." ],
     [ "Siparişimle ilgili nasıl bilgi alabilirim?",
       "Sipariş ve teslimat bilgileri ilgili sipariş adımında ve teslimat-iade sayfasında paylaşılır." ]
   ] %>
<main class="mx-auto w-full max-w-4xl px-5 py-12 sm:px-8 sm:py-16">
  <header class="rounded-4xl board px-7 py-9 text-white sm:px-10 sm:py-11">
    <p class="font-semibold text-[var(--amber)]">Yardım merkezi</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight sm:text-5xl">Sıkça sorulan sorular</h1>
    <p class="mt-4 max-w-2xl leading-7 text-[var(--on-board)]">Yöremden Gelen ve alışveriş deneyimi hakkında merak ettiklerin için yanıtlar.</p>
  </header>

  <section aria-label="Sıkça sorulan sorular" class="mt-7 space-y-3">
    <% questions.each_with_index do |(question, answer), index| %>
      <details class="group rounded-2xl border border-[var(--line)] bg-[var(--paper-hi)] p-5 shadow-sm transition open:border-[var(--line)] open:shadow-md sm:p-6">
        <summary class="flex cursor-pointer list-none items-center gap-4 font-semibold text-[var(--ink)] marker:hidden focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--blue)]">
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-[var(--kraft)] text-sm font-bold text-[var(--blue-ink)]">0<%= index + 1 %></span>
          <span class="flex-1"><%= question %></span>
          <span class="text-xl text-[var(--blue-ink)] transition group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <p class="ml-13 mt-4 max-w-2xl leading-7 text-stone-600"><%= answer %></p>
      </details>
    <% end %>
  </section>
</main>
